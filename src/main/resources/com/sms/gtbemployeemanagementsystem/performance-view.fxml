<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="20.0" style="-fx-background-color: #D6E2F4;" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <VBox spacing="2.0">
        <Label text="Performance Appraisals" style="-fx-text-fill: #14213D; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Track employee evaluations, core feedback scores, and targets" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
    </VBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
            <Label text="Review Analytics Registry" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
            <TableView fx:id="performanceTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn text="ID" prefWidth="70.0"/>
                    <TableColumn text="Employee Name" prefWidth="180.0"/>
                    <TableColumn text="Department" prefWidth="130.0"/>
                    <TableColumn text="Review Score" prefWidth="110.0"/>
                    <TableColumn text="Evaluation Term" prefWidth="120.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="20.0" prefWidth="300.0" minWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
            <Label text="Target Metrics Progress" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>

            <VBox spacing="15.0" style="-fx-padding: 10 0 0 0;">
                <VBox spacing="5.0">
                    <Label text="Project Milestones Cleared" style="-fx-text-fill: #4b5563; -fx-font-size: 13px;"/>
                    <ProgressBar progress="0.82" maxWidth="Infinity" style="-fx-accent: #14213D; -fx-pref-height: 8;"/>
                    <HBox alignment="CENTER_RIGHT"><Label text="82%" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/></HBox>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Quarterly Attendance Ratio" style="-fx-text-fill: #4b5563; -fx-font-size: 13px;"/>
                    <ProgressBar progress="0.95" maxWidth="Infinity" style="-fx-accent: #10b981; -fx-pref-height: 8;"/>
                    <HBox alignment="CENTER_RIGHT"><Label text="95%" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/></HBox>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Training Modules Concluded" style="-fx-text-fill: #4b5563; -fx-font-size: 13px;"/>
                    <ProgressBar progress="0.45" maxWidth="Infinity" style="-fx-accent: #f59e0b; -fx-pref-height: 8;"/>
                    <HBox alignment="CENTER_RIGHT"><Label text="45%" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/></HBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
