<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.EmployeeDashboardController">

    <!-- Sidebar -->
    <VBox prefWidth="270.0" minWidth="270.0" style="-fx-background-color: #14213D;">
        <padding>
            <Insets top="30.0" left="20.0" right="20.0" bottom="20.0"/>
        </padding>

        <Label text="GTB Portal" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;">
            <VBox.margin>
                <Insets bottom="20.0"/>
            </VBox.margin>
        </Label>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <VBox.margin>
                <Insets bottom="30.0"/>
            </VBox.margin>
            <StackPane fx:id="photoContainer" prefWidth="56.0" prefHeight="56.0" maxWidth="56.0" maxHeight="56.0"
                       onMouseClicked="#handlePhotoView" style="-fx-cursor: hand;">
                <Circle fx:id="photoPlaceholder" radius="28.0" fill="rgba(255,255,255,0.20)"/>
                <ImageView fx:id="profileImageView" fitWidth="56.0" fitHeight="56.0" pickOnBounds="true" preserveRatio="false"/>
                <Label fx:id="photoPlusLabel" text="+" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label fx:id="nameLabel" text="" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label fx:id="idLabel" text="" style="-fx-text-fill: #C7D0E0; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane fx:id="bellContainer" onMouseClicked="#handleBellClick" style="-fx-cursor: hand;" prefWidth="30.0" prefHeight="30.0">
                <Label text="🔔" style="-fx-font-size: 18px;"/>
                <StackPane fx:id="unreadBadge" maxWidth="16.0" maxHeight="16.0" translateX="10.0" translateY="-10.0" style="-fx-background-color: #ef4444; -fx-background-radius: 50%;">
                    <Label fx:id="unreadCountLabel" text="" style="-fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                </StackPane>
            </StackPane>
        </HBox>

        <VBox spacing="8.0">
            <Button fx:id="attendanceNavBtn" text="Attendance" onAction="#showAttendance" maxWidth="Infinity"
                    style="-fx-background-color: white; -fx-text-fill: #14213D; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="leaveNavBtn" text="Leave Requests" onAction="#showLeaveRequests" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="documentsNavBtn" text="Documents" onAction="#showDocuments" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="payrollNavBtn" text="Payroll" onAction="#showPayroll" maxWidth="Infinity" visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="payrollHistoryNavBtn" text="Payroll History" onAction="#showPayrollHistory" maxWidth="Infinity" visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="departmentsNavBtn" text="Departments" onAction="#showDepartments" maxWidth="Infinity" visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="projectsNavBtn" text="Projects" onAction="#showProjects" maxWidth="Infinity" visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="settingsNavBtn" text="Settings" onAction="#showSettings" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Button text="Log Out" onAction="#handleLogout" maxWidth="Infinity"
                style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px; -fx-cursor: hand;"/>
    </VBox>

    <!-- Content Area -->
    <VBox fx:id="contentArea" HBox.hgrow="ALWAYS" style="-fx-background-color: #D6E2F4;"/>

</HBox>
