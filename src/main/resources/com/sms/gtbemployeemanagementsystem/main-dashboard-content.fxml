<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.com/fxml/1"
      spacing="20.0" style="-fx-background-color: #D6E2F4;" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" prefHeight="50.0">
        <VBox spacing="2.0">
            <Label text="Dashboard Overview" style="-fx-text-fill: #14213D; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="System Metrics Summary" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
        </VBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="15.0">
            <TextField promptText="🔍 Search..." style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #D6DCE8; -fx-border-radius: 20; -fx-padding: 8 15; -fx-pref-width: 220;"/>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Alex Green" style="-fx-font-weight: bold; -fx-text-fill: #14213D; -fx-font-size: 14px;"/>
                <Label text="Admin" style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <HBox spacing="15.0">
                <VBox HBox.hgrow="ALWAYS" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                    <Label text="Total Employees" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="totalEmployeesLabel" text="--" style="-fx-text-fill: #14213D; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Live Database Count" style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                    <Label text="Pending Leaves" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="pendingLeavesLabel" text="--" style="-fx-text-fill: #14213D; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Requires action" style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                    <Label text="New Hires" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="newHiresLabel" text="--" style="-fx-text-fill: #14213D; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Joined this month" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                    <Label text="Payroll Status" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="payrollStatusLabel" text="Active" style="-fx-text-fill: #1D3A8A; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 4 0;"/>
                    <Label text="Updated today" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <VBox VBox.vgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Recent Employee Directory Profiles" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
                        <TextField promptText="Search details..." style="-fx-background-color: #F8FAFC; -fx-border-color: #D6DCE8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 10;"/>
                        <ComboBox promptText="Department" style="-fx-background-color: white; -fx-border-color: #D6DCE8; -fx-border-radius: 6;"/>
                    </HBox>
                </HBox>

                <TableView fx:id="dashboardEmployeeTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="dashIdColumn" text="ID" prefWidth="70.0"/>
                        <TableColumn fx:id="dashNameColumn" text="Name" prefWidth="180.0"/>
                        <TableColumn fx:id="dashDepartmentColumn" text="Department" prefWidth="130.0"/>
                        <TableColumn fx:id="dashRoleColumn" text="Role" prefWidth="130.0"/>
                        <TableColumn fx:id="dashStatusColumn" text="Status" prefWidth="100.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>

        <VBox spacing="20.0" prefWidth="280.0" minWidth="280.0">
            <VBox VBox.vgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                <Label text="Recent System Logs" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                <VBox spacing="14.0">
                    <VBox spacing="2.0">
                        <Label text="Alex Green synchronized ledger entries" style="-fx-font-size: 13px; -fx-text-fill: #374151; -fx-font-weight: 500;"/>
                        <Label text="Just now" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.06), 8, 0, 0, 2);">
                <Label text="Quick Navigation Shortcuts" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                <Button text="Launch Global Notice" maxWidth="Infinity" style="-fx-background-color: #14213D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
