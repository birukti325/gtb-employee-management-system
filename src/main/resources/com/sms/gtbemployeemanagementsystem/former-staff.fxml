<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" style="-fx-background-color: #D6E2F4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.FormerStaffController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <VBox spacing="5.0">
            <Label text="Former Staff" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
            <Label text="Employees who are no longer active" style="-fx-font-size: 13px; -fx-text-fill: #1D3A8A;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by name..." style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #D6DCE8; -fx-background-color: white; -fx-pref-width: 220px; -fx-pref-height: 35px;"/>
    </HBox>

    <TableView fx:id="leftEmployeesTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: #D6DCE8;">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Name" />
            <TableColumn fx:id="departmentColumn" prefWidth="200.0" text="Last Department" />
            <TableColumn fx:id="roleColumn" prefWidth="180.0" text="Last Role" />
            <TableColumn fx:id="leaveDateColumn" prefWidth="160.0" text="Leave Date" />
            <TableColumn fx:id="actionsColumn" prefWidth="90.0" text="Actions" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
