<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.ProjectsViewController"
      spacing="20.0" style="-fx-background-color: #D6E2F4;" VBox.vgrow="ALWAYS">


    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="2.0">
        <Label text="Project Workspace" style="-fx-text-fill: #14213D; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Monitor active assignments, task distributions, and milestone tracking metrics" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
    </VBox>

    <!-- Main Workspace Layout Split -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <!-- Left Side: Main Projects Tracking Board -->
        <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #D6DCE8; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.10), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT">
                <Label text="Active Development Initiatives" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <TextField fx:id="searchField" promptText="🔍 Search projects..." style="-fx-background-color: #F8FAFC; -fx-border-color: #D6DCE8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12;"/>
                </HBox>
            </HBox>

            <TableView fx:id="projectsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="idColumn" text="Proj ID" prefWidth="80.0"/>
                    <TableColumn fx:id="titleColumn" text="Project Title" prefWidth="250.0"/>
                    <TableColumn fx:id="departmentColumn" text="Assigned Department" prefWidth="200.0"/>
                    <TableColumn fx:id="leadColumn" text="Project Lead" prefWidth="180.0"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right Side: Milestone Completion Status Panel -->
        <VBox spacing="20.0" prefWidth="290.0" minWidth="290.0">
            <!-- Project Execution Actions Container -->
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #D6DCE8; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(20,33,61,0.10), 8, 0, 0, 2);">
                <Label text="Project Management" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                <Button fx:id="initializeProjectBtn" text="➕ Initialize New Project" onAction="#handleInitializeProject" maxWidth="Infinity" style="-fx-background-color: #14213D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;"/>
            </VBox>
        </VBox>

    </HBox>
</VBox>
