<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.EmployeeProjectsController"
      spacing="20.0" style="-fx-background-color: #D6E2F4;" VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <VBox spacing="2.0">
        <Label text="My Projects" style="-fx-text-fill: #14213D; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Projects you are leading — use the 3-dot menu to update details or write a report."
               style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
    </VBox>

    <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #D6DCE8; -fx-border-radius: 10;">
        <TableView fx:id="myProjectsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="idColumn" text="Proj ID" prefWidth="70.0"/>
                <TableColumn fx:id="titleColumn" text="Project Title" prefWidth="220.0"/>
                <TableColumn fx:id="departmentColumn" text="Department" prefWidth="200.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="130.0"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="90.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
