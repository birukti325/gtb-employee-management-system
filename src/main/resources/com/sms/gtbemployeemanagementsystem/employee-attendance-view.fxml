<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #D6E2F4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.EmployeeAttendanceController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="My Attendance" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>

    <VBox spacing="15.0" maxWidth="500.0" style="-fx-background-color: white; -fx-padding: 25px; -fx-background-radius: 12px; -fx-border-color: #D6DCE8; -fx-border-radius: 12px;">
        <Label text="Today's Status" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #14213D;"/>
        <Label fx:id="todayStatusLabel" text="Not checked in yet" style="-fx-text-fill: #1D3A8A;"/>

        <HBox spacing="15.0">
            <Button fx:id="checkInBtn" text="Check In" onAction="#handleCheckIn" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 12px;"/>
            <Button fx:id="checkOutBtn" text="Check Out" onAction="#handleCheckOut" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #14213D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 12px;"/>
        </HBox>

        <HBox spacing="15.0">
            <Button fx:id="lunchOutBtn" text="Lunch Out" onAction="#handleLunchOut" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 12px;"/>
            <Button fx:id="lunchInBtn" text="Lunch Back" onAction="#handleLunchIn" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #1D3A8A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 12px;"/>
        </HBox>
    </VBox>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #D6DCE8; -fx-border-radius: 12px;">
        <Label text="My Attendance History" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #14213D;"/>
        <TableView fx:id="myAttendanceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0"/>
                <TableColumn fx:id="checkInColumn" text="Check In" prefWidth="110.0"/>
                <TableColumn fx:id="lunchOutColumn" text="Lunch Out" prefWidth="110.0"/>
                <TableColumn fx:id="lunchInColumn" text="Lunch Back" prefWidth="110.0"/>
                <TableColumn fx:id="checkOutColumn" text="Check Out" prefWidth="110.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
