<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sms.gtbemployeemanagementsystem.controller.DashboardController"
            prefWidth="1200" prefHeight="720" style="-fx-font-family: 'Segoe UI', sans-serif;">

    <left>
        <VBox spacing="6.0" style="-fx-background-color: #14213D;" prefWidth="240">
            <padding>
                <Insets top="30" bottom="25" left="15" right="15"/>
            </padding>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets bottom="25"/>
                </VBox.margin>
                <ImageView fitWidth="32.0" fitHeight="32.0" preserveRatio="true">
                    <image>
                        <Image url="@gtb-logo-transparent.png"/>
                    </image>
                </ImageView>
                <Label text="GTB EMS" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="notificationBell" onMouseClicked="#handleNotificationClick" style="-fx-cursor: hand;">
                    <Label text="🔔" style="-fx-font-size: 18px;"/>
                    <StackPane fx:id="notificationBadge" visible="false" maxWidth="16.0" maxHeight="16.0"
                               translateX="10.0" translateY="-10.0" style="-fx-background-color: #ef4444; -fx-background-radius: 50%;">
                        <Label fx:id="notificationCountLabel" text="" style="-fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                    </StackPane>
                </StackPane>
            </HBox>

            <Button fx:id="dashboardBtn" text="📊  Dashboard" onAction="#showDashboard" maxWidth="Infinity" style="-fx-background-color: white; -fx-text-fill: #14213D; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6; -fx-font-weight: bold;"/>

            <Button fx:id="employeesBtn" text="👤  Staff          ▼" onAction="#toggleEmployeeMenu" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>

            <VBox fx:id="employeeSubmenu" spacing="4.0" managed="false" visible="false">
                <padding>
                    <Insets left="25" top="2" bottom="5"/>
                </padding>
                <Button fx:id="employeeDirectoryBtn" text="📁  Directory" onAction="#showEmployees" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-padding: 8 15; -fx-background-radius: 6;"/>
                <Button fx:id="addNewEmployeeBtn" text="➕  Add New" onAction="#showAddNewEmployee" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-padding: 8 15; -fx-background-radius: 6;"/>
            </VBox>
            <Button fx:id="leftEmployeesBtn" text="🚪  Former Staff" onAction="#showLeftEmployees" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #DCE3F0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-padding: 8 15; -fx-background-radius: 6;"/>
            <Button fx:id="departementsBtn" text="🏢  Departments" onAction="#showDepartements" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>
            <Button fx:id="attendanceBtn" text="🕒  Attendance" onAction="#showAttendance" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>
            <Button fx:id="leaveBtn" text="📋  Leave Requests" onAction="#showLeave" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>
            <Button fx:id="payrollBtn" text="💰  Payroll" onAction="#showPayroll" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>
            <Button fx:id="projectsBtn" text="📁  Projects" onAction="#showProjects" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>
            <Button fx:id="adminSettingsBtn" text="🛠  Settings" onAction="#showAdminSettings" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C7D0E0; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 12 15; -fx-background-radius: 6;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button fx:id="logOutBtn" text="🚪  Log Out" onAction="#handleLogout" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px; -fx-padding: 10 15; -fx-background-radius: 6;"/>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea" style="-fx-background-color: #D6E2F4;" />
    </center>

</BorderPane>
