<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.AttendanceViewController"
      spacing="20.0" style="-fx-background-color: #D6E2F4;" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" prefHeight="50.0">
        <VBox spacing="2.0">
            <Label text="Attendance Tracking" style="-fx-text-fill: #14213D; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Manage daily employee check-ins and time logs" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="15.0" prefWidth="400.0" minWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #D6DCE8; -fx-border-radius: 8px; -fx-padding: 20;">

            <!-- Calendar Header: month nav -->
            <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #14213D; -fx-background-radius: 8; -fx-padding: 12 10;">
                <Button text="◀" onAction="#handlePrevMonth" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-min-width: 30; -fx-min-height: 30; -fx-max-width: 30; -fx-max-height: 30; -fx-cursor: hand;"/>
                <Label fx:id="monthLabel" text="" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Button text="▶" onAction="#handleNextMonth" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-min-width: 30; -fx-min-height: 30; -fx-max-width: 30; -fx-max-height: 30; -fx-cursor: hand;"/>
            </HBox>

            <!-- Calendar Grid -->
            <GridPane fx:id="calendarGrid" hgap="6.0" vgap="10.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Label text="Sun" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Mon" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Tue" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Wed" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Thu" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Fri" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="5" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
                <Label text="Sat" style="-fx-text-fill: #1D3A8A; -fx-font-weight: bold; -fx-font-size: 12px;" GridPane.columnIndex="6" GridPane.rowIndex="0" GridPane.halignment="CENTER"/>
            </GridPane>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #D6DCE8; -fx-border-radius: 8px; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Daily Attendance Registry" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
                    <TextField fx:id="searchField" promptText="Search employee..." style="-fx-background-color: white; -fx-border-color: #D6DCE8; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    <ComboBox fx:id="departmentFilter" promptText="Department" style="-fx-background-color: white; -fx-border-color: #D6DCE8; -fx-border-radius: 6;"/>
                    <Button fx:id="clearFilterBtn" text="✕" onAction="#handleClearFilters" style="-fx-background-color: #E8ECF5; -fx-text-fill: #14213D; -fx-background-radius: 6px; -fx-pref-height: 26px; -fx-pref-width: 30px; -fx-font-weight: bold;"/>
                    <Button fx:id="exportBtn" text="Export to Excel" onAction="#handleExportExcel" style="-fx-background-color: #14213D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 6px 14px; -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="idCol" text="Emp ID" prefWidth="80.0"/>
                    <TableColumn fx:id="nameCol" text="Employee Name" prefWidth="180.0"/>
                    <TableColumn fx:id="deptCol" text="Department" prefWidth="120.0"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="100.0"/>
                    <TableColumn fx:id="inCol" text="Clock In" prefWidth="110.0"/>
                    <TableColumn fx:id="lunchOutCol" text="Lunch Out" prefWidth="110.0"/>
                    <TableColumn fx:id="lunchInCol" text="Lunch Back" prefWidth="110.0"/>
                    <TableColumn fx:id="outCol" text="Clock Out" prefWidth="110.0"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="110.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>