<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        spacing="20.0"
        style="-fx-background-color: #D6E2F4;"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.sms.gtbemployeemanagementsystem.controller.DepartmentsController">

    <padding>
        <Insets
                bottom="30.0"
                left="30.0"
                right="30.0"
                top="30.0"/>
    </padding>


    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <VBox spacing="5.0">

        <Label
                style="-fx-font-size: 24px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #14213D;"
                text="Departments Management"/>

        <Label
                style="-fx-font-size: 13px;
                       -fx-text-fill: #1D3A8A;"
                text="Overview of corporate organizational structures, regional offices, and department leadership metrics"/>

    </VBox>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <HBox
            spacing="25.0"
            VBox.vgrow="ALWAYS">


        <!-- ================================================= -->
        <!-- DEPARTMENT TABLE -->
        <!-- ================================================= -->

        <VBox
                spacing="15.0"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: white;
                       -fx-background-radius: 8px;
                       -fx-border-color: #D6DCE8;
                       -fx-border-radius: 8px;">

            <padding>
                <Insets
                        bottom="20.0"
                        left="20.0"
                        right="20.0"
                        top="20.0"/>
            </padding>


            <TableView
                    fx:id="departmentTable"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;">

                <columns>

                    <!-- Department ID -->
                    <TableColumn
                            fx:id="colDeptId"
                            prefWidth="80.0"
                            text="Dept ID"/>


                    <!-- Department Name -->
                    <TableColumn
                            fx:id="colDeptName"
                            prefWidth="220.0"
                            text="Department Name"/>


                    <!-- Department Head -->
                    <TableColumn
                            fx:id="colDeptHead"
                            prefWidth="160.0"
                            text="Department Head"/>


                    <!-- Location -->
                    <TableColumn
                            fx:id="colLocation"
                            prefWidth="150.0"
                            text="Location"/>


                    <!-- Employee Count -->
                    <TableColumn
                            fx:id="colTotalEmployees"
                            prefWidth="130.0"
                            text="Total Employees"/>


                    <!-- Actions -->
                    <TableColumn
                            fx:id="colActions"
                            prefWidth="80.0"
                            text="Actions"/>

                </columns>


                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>

        </VBox>


        <!-- ================================================= -->
        <!-- RIGHT SIDEBAR -->
        <!-- ================================================= -->

        <VBox
                prefWidth="280.0"
                spacing="20.0">


            <VBox
                    spacing="12.0"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8px;
                           -fx-border-color: #D6DCE8;
                           -fx-border-radius: 8px;">

                <padding>
                    <Insets
                            bottom="20.0"
                            left="15.0"
                            right="15.0"
                            top="15.0"/>
                </padding>


                <!-- Sidebar title -->
                <Label
                        style="-fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-text-fill: #14213D;"
                        text="Department Actions"/>


                <!-- Add Department -->
                <Button
                        maxWidth="1.7976931348623157E308"
                        onAction="#handleAddDepartment"
                        style="-fx-background-color: #14213D;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10px;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;"
                        text="+ Add Department"/>


                <!-- Analytics -->
                <Button
                        maxWidth="1.7976931348623157E308"
                        onAction="#handleViewAnalytics"
                        style="-fx-background-color: white;
                               -fx-text-fill: #14213D;
                               -fx-border-color: #D6DCE8;
                               -fx-border-radius: 6px;
                               -fx-padding: 10px;
                               -fx-cursor: hand;"
                        text="📊 View Analytics"/>

            </VBox>

        </VBox>

    </HBox>

</VBox>
