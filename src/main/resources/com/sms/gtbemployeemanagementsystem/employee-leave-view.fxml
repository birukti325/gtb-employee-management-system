<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="25.0" style="-fx-background-color: #D6E2F4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sms.gtbemployeemanagementsystem.controller.EmployeeLeaveController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Header -->
    <Label text="My Leave Requests" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>

    <!-- Form Section -->
    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 25px; -fx-background-radius: 12px; -fx-border-color: #D6DCE8; -fx-border-radius: 12px;">
        <Label text="Submit New Leave Request" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>

        <VBox spacing="12.0" prefWidth="550.0">
            <!-- Leave Type -->
            <VBox spacing="6.0">
                <Label text="Leave Type" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
                <ComboBox fx:id="leaveTypeInput" promptText="Select leave type" maxWidth="Infinity" prefHeight="35.0"/>
            </VBox>

            <!-- Dates Row -->
            <HBox spacing="15.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Start Date" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
                    <DatePicker fx:id="startDateInput" maxWidth="Infinity" prefHeight="35.0"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="End Date" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
                    <DatePicker fx:id="endDateInput" maxWidth="Infinity" prefHeight="35.0"/>
                </VBox>
            </HBox>

            <!-- Reason -->
            <VBox spacing="6.0">
                <Label text="Reason" style="-fx-text-fill: #1D3A8A; -fx-font-size: 12px;"/>
                <TextArea fx:id="reasonInput" prefHeight="45.0" wrapText="true"/>
            </VBox>

            <!-- Submit Button -->
            <Button text="Submit Request" onAction="#handleSubmit"
                    style="-fx-background-color: #14213D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- History Table Section -->
    <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 25px; -fx-background-radius: 12px; -fx-border-color: #D6DCE8; -fx-border-radius: 12px;">
        <Label text="My Request History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14213D;"/>

        <TableView fx:id="myLeaveTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="150.0"/>
                <TableColumn fx:id="startColumn" text="Start Date" prefWidth="150.0"/>
                <TableColumn fx:id="endColumn" text="End Date" prefWidth="150.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="150.0"/>
                <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="200.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
